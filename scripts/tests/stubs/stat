#!/bin/bash
# Fake stat: when the format starts with %U and $FAKE_OWNER (path<TAB>user) maps
# the file, report that user as the owner. Every other field, and every other
# call, is the real stat.
if [[ "$1" == "-c" && "$2" == %U* && -n "${FAKE_OWNER:-}" ]]; then
    path="$3"; [[ "$path" == "--" ]] && path="$4"
    owner=$(awk -F'\t' -v p="$path" '$1==p{print $2}' "$FAKE_OWNER" 2>/dev/null)
    if [[ -n "$owner" ]]; then
        real=$(/usr/bin/stat "$@") || exit $?
        if [[ "$2" == "%U" ]]; then printf '%s\n' "$owner"; else printf '%s %s\n' "$owner" "${real#* }"; fi
        exit 0
    fi
fi
exec /usr/bin/stat "$@"
