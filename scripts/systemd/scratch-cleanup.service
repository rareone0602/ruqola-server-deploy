[Unit]
Description=Scratch Folder Cleanup Service
Documentation=man:find(1)
After=multi-user.target
Wants=scratch-cleanup.timer
# Run only with /scratch mounted, never against the empty mount point. This key
# belongs in [Unit]; in [Service] systemd ignores it (E16).
RequiresMountsFor=/scratch

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/bin/scratch-cleanup.sh
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# Writable: only the scratch directories the reaper cleans (never /scratch itself
# or /scratch/datasets), the logs and deletion record, and the lock. '-' lets the
# unit start if one of them is missing; the script then warns and skips it.
ReadWritePaths=-/scratch/shared -/scratch/temp -/scratch/users /var/log /run
# msmtp writes a temporary file before sending. ProtectSystem=strict leaves /tmp
# read-only, so without a private /tmp every warning and deletion mail failed.
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true

# No time limit (todo E18): deleting one ~4.8-million-file cohort is estimated at
# ~40 min, and a run killed mid-deletion sends no mail that night. The cost: the
# timer cannot start a run while one is active, so a stuck run blocks every later
# night. It shows as "activating" in: systemctl status scratch-cleanup
TimeoutStartSec=infinity
TimeoutStopSec=300
